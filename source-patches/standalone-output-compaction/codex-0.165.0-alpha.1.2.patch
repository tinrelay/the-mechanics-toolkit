+#[test]
+fn assemble_compaction_history_places_context_before_standalone_external_input() {
+    let older_user = user_message("older completed task");
+    let standalone_output: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "function_call_output",
+        "name": "send_message_to_thread",
+        "namespace": "codex_app",
+        "output": "current delegated task"
+    }))
+    .unwrap();
+    let initial_context: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "message",
+        "role": "developer",
+        "content": [{"type": "input_text", "text": "fresh permissions"}]
+    }))
+    .unwrap();
+    let compaction = ResponseItem::Compaction {
+        id: None,
+        encrypted_content: "encrypted".to_string(),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let refreshed = raw(assemble_compaction_history(
+        annotated(vec![older_user.clone(), standalone_output.clone(), compaction.clone()]),
+        Vec::new(),
+        vec![initial_context.clone()],
+    ));
+    assert_eq!(refreshed, vec![older_user, initial_context, standalone_output, compaction]);
+}
